<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标背景层：青瓷蓝绿斜向渐变，带一点柔和的光感 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="4"
                android:endX="100"
                android:endY="104">
                <item android:offset="0" android:color="#FF57A89F" />
                <item android:offset="0.55" android:color="#FF2F6E6A" />
                <item android:offset="1" android:color="#FF1E4E4A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左上角一层很淡的高光，避免整块死板 -->
    <path android:pathData="M0,0 L108,0 L108,44 C74,62 34,40 0,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="60">
                <item android:offset="0" android:color="#26FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
